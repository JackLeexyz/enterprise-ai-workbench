# Use a NEW server block only. Verify DNS and issue a certificate for this exact host first.
server {
    listen 80;
    server_name workbench.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name workbench.example.com;
    ssl_certificate /etc/letsencrypt/live/workbench.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workbench.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # The application still caps JSON at 512 KiB and file bodies at 2 MiB.
    client_max_body_size 3m;
    add_header Strict-Transport-Security "max-age=86400" always;
    location / {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
